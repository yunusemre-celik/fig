{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fig",
  "version": "0.1.0",
  "identifier": "com.fig.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fig - Dosya Araç Kiti",
        "width": 980,
        "height": 720,
        "minWidth": 780,
        "minHeight": 580,
        "center": true,
        "decorations": true,
        "transparent": true
      },
      {
        "label": "wheel",
        "title": "Fig Wheel",
        "url": "index.html?window=wheel",
        "width": 460,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
